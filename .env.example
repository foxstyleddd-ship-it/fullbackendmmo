# Environment Configuration Example
# Copy to .env and fill with actual values

# Server
ENV=development
API_PORT=8080
ZONE_PORT=8081

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=hpmmo
DB_PASSWORD=hpmmo_dev_password
DB_NAME=hpmmo
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=hpmmo_redis_password
REDIS_DB=0

# NATS
NATS_URL=nats://localhost:4222

# JWT
JWT_SECRET=change_this_in_production
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TOKEN_DURATION=24h
JWT_REFRESH_TOKEN_DURATION=720h

# Session
SESSION_DURATION=24h
CONNECTION_TOKEN_DURATION=30s
TRANSFER_TOKEN_DURATION=30s

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9091

# Zone Server
ZONE_ID=hogwarts_main
ZONE_SHARD=shard-0
ZONE_MAX_PLAYERS=500
ZONE_TICK_RATE_MS=50
ZONE_HEARTBEAT_INTERVAL_MS=10000

# Anti-Cheat
ANTICHEAT_ENABLED=true
ANTICHEAT_SPEED_VIOLATION_THRESHOLD=10
ANTICHEAT_INVALID_ACTION_THRESHOLD=20
ANTICHEAT_PACKET_FLOOD_THRESHOLD=200
